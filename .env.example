# 이 파일을 .env로 복사한 뒤 현재 PC 환경에 맞게 수정하세요.

# 웹 앱
APP_HOST=127.0.0.1
APP_PORT=8000

# 로컬 파일 저장 위치 (프로젝트 폴더 기준 상대 경로 사용 가능)
RECIPE_DATA_DIR=data
RECIPE_RUNTIME_DIR=.runtime

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
EMBEDDING_MODEL=embeddinggemma

# 자막이 없을 때 사용하는 로컬 Whisper
WHISPER_MODEL=base

# Qdrant Local
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=RecipeV1
